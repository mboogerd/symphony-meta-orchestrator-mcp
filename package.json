{
  "name": "symphony-meta-orchestrator-mcp",
  "version": "0.1.0",
  "description": "MCP server and CLI scaffold for the Symphony meta-orchestrator.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "symphony-meta-orchestrator": "./dist/cli/index.js",
    "symphony-meta-orchestrator-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "dev": "node --watch src/mcp/stdio.ts",
    "build": "node --no-warnings scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "cli": "node src/cli/index.ts",
    "mcp": "node src/mcp/stdio.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "linear",
    "symphony"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@linear/sdk": "^84.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  }
}
